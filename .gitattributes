# Normalize text files and keep consistent line endings across platforms
* text=auto

# Script and source line endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Common binary artifacts
*.pt binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.7z binary
*.pdf binary
